ADAM_COMPANY_TOKEN=
ADAM_SYNC_SECRET=
ADAM_API_BASE_URL=https://services.adamtotal.co.il/api/Career

# Not currently wired to any route — kept for a possible future resume-parsing
# step (name/phone/city/experience/skills extraction). See lib/resume-parser.ts
# and docs/intake-ux-notes.md for why the parse/confirm screen was cut.
OPENAI_API_KEY=

# Used to email the uploaded resume to the recruiting inbox. See
# lib/send-application-email.ts. Get a key at resend.com; RESEND_FROM_EMAIL
# must be an address on a domain verified in Resend (DNS records), or sends
# will fail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
JOBS_INBOX_EMAIL=jobs@extreme.co.il

# Microsoft Graph mailbox ingestion (lib/resume-mailbox-ingest.ts) — reads
# resumes emailed directly to MICROSOFT_GRAPH_MAILBOX and saves them into the
# same candidate_applications table as the website form (source:
# "resume-mailbox"). Requires an Azure AD app registration with an
# Application (not delegated) Mail.Read + Mail.ReadWrite permission,
# admin-consented, scoped to this one mailbox. Keep
# MICROSOFT_GRAPH_CLIENT_SECRET as an encrypted/secret environment variable
# in production; never commit its value.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_MAILBOX=resume@extreme.co.il

# Shared secret for manually triggering /api/resume-mailbox/sync, same
# pattern as ADAM_SYNC_SECRET. The cron trigger (every 10 min) doesn't need
# this — only on-demand HTTP calls do.
RESUME_MAILBOX_SYNC_SECRET=
